import re
import json

text = transcript
if isinstance(text, str):
    chunks = [text[i:i+500] for i in range(0, len(text), 500)]
else:
    chunks = text

combined_summary = ""
for idx, chunk in enumerate(chunks):
    prompt = "Summarize the following text in one naive, plain-text sentence:\n\n" + chunk + "\n\nSummary:"
    response = llm_query(prompt)

    match = re.search(r'\{.*\}', response, re.DOTALL)
    extracted = match.group(0) if match else response

    if idx == 0:
        combined_summary = extracted
    else:
        combined_summary += " " + extracted

    output = {"summary": combined_summary}
    with open("output_rlm.json", "w", ensure_ascii=False) as f:
        json.dump(output, f, ensure_ascii=False)
```

