import re
import json

# Ensure we have a single string to work with
text = transcript if isinstance(transcript, str) else "\n".join(transcript)

# Split into bounded chunks so the loop completes quickly
max_chunk = 600
chunks = [text[i:i+max_chunk] for i in range(0, len(text), max_chunk)]

combined_summary = ""

for chunk in chunks:
    # Build prompt using concatenation to avoid f-string brace escaping issues
    prompt = "Summarize the following conversation chunk in one naive, plain-text sentence. Keep it concise:\n\n" + chunk
    response = llm_query(prompt)

    # Robustly extract a JSON block from the LLM response
    match = re.search(r'\{.*\}', response, re.DOTALL)
    if match:
        block = match.group(0)
        try:
            parsed = json.loads(block)
            summary = parsed.get("summary", block)
        except json.JSONDecodeError:
            # Fall back to raw text inside the braces
            summary = block[1:-1].strip() if block.startswith('{') and block.endswith('}') else block
    else:
        summary = response.strip()

    # Accumulate the overall summary
    combined_summary += " " + summary

